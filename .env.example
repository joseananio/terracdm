# Optional browser-safe Supabase client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase persistence. Use a secret/service-role key here, never a sb_publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
WORKFLOW_LOCAL_BASE_URL=http://localhost:3003
WORKFLOW_LOCAL_DATA_DIR=.next/workflow-data
# Optional server-only instance YAML. Defaults to ./terracdm.yaml when present.
TERRACDM_CONFIG=

# Provider credentials stay server-side. Routes report key_required until configured.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
FIRMS_API_KEY=
FIRMS_MAP_KEY=
WSDOT_ACCESS_CODE=
ACLED_ENABLED=false
ACLED_USERNAME=
ACLED_PASSWORD=
NVD_API_KEY=
ABUSE_CH_AUTH_KEY=
OPENSANCTIONS_API_TOKEN=
N2YO_API_KEY=
TELEGRAM_CHANNELS=sentdefender,osintdefender,OSINTtechnical,warmonitors,UAWeapons
SCANNER_URL=
SCANNER_KEY=

# Server-only AI providers. OpenAI is tried first; Anthropic is used if it fails.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_MODEL=claude-sonnet-5
